# TraderDesk public configuration template.
# Copy this file to .env. Never commit the resulting .env file.

# ProjectX / TopstepX API
PROJECTX_API_BASE=https://api.topstepx.com
PROJECTX_USER=
PROJECTX_API_KEY=

# Safety defaults
DRY_RUN=true
ONLY_PRACTICE_ACCOUNT=true
PRACTICE_ACCOUNT_ID=

# Market analysis
RUN_SYMBOLS=MNQ,ES
CONTRACT_ID_MNQ=
CONTRACT_ID_ES=
CONTRACT_ID_MES=
BAR_MINUTES=15
BAR_TIMESTAMP_MODE=open
ALIGN_TIMEZONE=America/New_York
CHART_SESSION=ETH
INCLUDE_PARTIAL_BARS=false

# Entry schedule
ENABLE_TRADING_HOURS=true
TRADING_TIMEZONE=America/New_York
TRADING_START_TIME=09:30
TRADING_END_TIME=13:30
FORCE_CLOSE_TIME=16:00
AUTO_CLOSE_AT_END=true

# Execution and risk limits
ORDER_PLACEMENT_MODE=bracket
ORDER_SIZE_MNQ=1
ORDER_SIZE_ES=1
TP_POINTS_MNQ=60
SL_POINTS_MNQ=30
TP_POINTS_ES=8
SL_POINTS_ES=5
MAX_ACTIVE_POSITIONS=1
MAX_POSITIONS_PER_SYMBOL=1
PROCESS_SIGNALS_WHILE_ACTIVE=false
SKIP_PRECHECK_DUPLICATES=false

# ES SHORT can execute on MES
ES_SHORT_USE_MES=true
ES_SHORT_SIZE=1
ES_SHORT_TP_POINTS=10
ES_SHORT_SL_POINTS=7

# Timing
CLOSE_LAG_SEC=1.2
CLOSE_RETRY_COUNT=15
CLOSE_RETRY_INTERVAL=0.5
ENABLE_PRELOAD=true
PRELOAD_SECONDS_BEFORE=5

# Optional status output and diagnostics
SHOW_REALTIME_STATUS=false
REALTIME_STATUS_INTERVAL=900
DEBUG_TRADE=false
DEBUG_LOG=debug.log
TRADES_LOG=trades.log
SEEN_SIGNALS_FILE=seen_signals.json

# Optional Telegram notifications
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STOP_SECRET=
DAILY_READY_ALERT_TIME=09:15
TELEGRAM_EMA_ALERT_DELAY_SEC=300

# Optional email notifications
NOTIFY_EMAIL=false
SMTP_HOST=
SMTP_PORT=0
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
